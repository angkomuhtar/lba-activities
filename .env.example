# Salin file ini menjadi `.env.local` lalu isi nilai yang sesuai.

# Koneksi Postgres Supabase (dipakai aplikasi saat runtime).
# Ambil di: Supabase -> Project Settings -> Database -> Connection string
# Pilih "URI" dengan mode "Transaction pooler" (port 6543, pgbouncer=true),
# lalu ganti [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Koneksi DIRECT (port 5432). KHUSUS untuk migrasi Prisma & Prisma Studio.
# Supabase -> Database -> Connection string -> "Direct connection", ganti [YOUR-PASSWORD].
# Migrasi TIDAK boleh lewat pooler (6543) karena error
# "prepared statement already exists".
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret untuk menandatangani session cookie.
# Generate dengan:  openssl rand -base64 32
SESSION_SECRET=akHJNFXzJtggMEh8qZpkCh2XZSYjNx7pJB4S1eejVtM=

# Konfigurasi seeder superadmin (opsional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_NAME=Super Admin